# Shared client-side Google Maps key used by the native Android and iOS maps.
# Restrict it in Google Cloud to the FreePark application identifiers/credentials.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_google_maps_key

# Optional production routing endpoint. The public OSRM endpoint is suitable only
# for development and low-volume testing.
EXPO_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org
